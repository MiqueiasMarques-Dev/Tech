int latchPin = 12;
int dataPin = 13;
int clockPin = 11;

// Escolha os 4 LEDs que ficarão acesos
int led1 = 1;
int led2 = 8;
int led3 = 15;
int led4 = 30;

byte leds[4] = {0, 0, 0, 0};

void setup() {

  pinMode(latchPin, OUTPUT);
  pinMode(dataPin, OUTPUT);
  pinMode(clockPin, OUTPUT);

  int numeros[4] = {led1, led2, led3, led4};

  for (int i = 0; i < 4; i++) {

    if (numeros[i] >= 1 && numeros[i] <= 32) {

      int registrador = (numeros[i] - 1) / 8;
      int bit = (numeros[i] - 1) % 8;

      bitSet(leds[registrador], bit);

    }

  }

  digitalWrite(latchPin, LOW);

  for (int i = 3; i >= 0; i--) {
    shiftOut(dataPin, clockPin, MSBFIRST, leds[i]);
  }

  digitalWrite(latchPin, HIGH);

}

void loop() {

}

