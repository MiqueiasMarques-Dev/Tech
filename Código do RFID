Parte 1:
#include <SPI.h>
#include <MFRC522.h>

// --- CONFIGURAÇÃO DO SEU CIRCUITO ---
#define RST_PIN   D3   // Fio Roxo no pino D3
#define SS_PIN    D4   // Fio Cinza no pino D4
MFRC522 mfrc522(SS_PIN, RST_PIN);

// UID do cartão alvo que o sensor deve reconhecer
const String UID_ALVO = "04 9C E7 7C D4 2A 81";

Parte 2:
    SPI.begin();           // Inicializa a comunicação SPI para o sensor
    mfrc522.PCD_Init();    // Inicializa o leitor RFID MFRC522

    Serial.print(F("Status do Leitor RFID: "));
    mfrc522.PCD_DumpVersionToSerial(); // Testa se o sensor está respondendo e mostra a versão no Monitor Serial

Parte 3:
    // 1. Verifica se há um novo cartão aproximado do sensor
    if (!mfrc522.PICC_IsNewCardPresent() || !mfrc522.PICC_ReadCardSerial()) {
        return; // Se não tiver cartão, sai do loop e tenta de novo na próxima linha
    }

    // 2. Converte o código hexadecimal guardado no cartão em formato de texto (String)
    String uidLida = "";
    for (byte i = 0; i < mfrc522.uid.size; i++) {
        uidLida += (mfrc522.uid.uidByte[i] < 0x10 ? "0" : "");
        uidLida += String(mfrc522.uid.uidByte[i], HEX);
        if (i < mfrc522.uid.size - 1) uidLida += " ";
    }
    uidLida.toUpperCase();

    Serial.print("Tag detectada UID: ");
    Serial.println(uidLida);

    // 3. Compara o código que o sensor leu com o seu UID_ALVO
    if (uidLida == UID_ALVO) {
        statusVideo = 1;
        tempoAtivacao = millis(); 
        Serial.println("Cartão CORRETO! Mostrando vídeo do Drive.");
    }

    // 4. Manda o sensor parar de ler este cartão até que ele seja retirado e colocado de novo
    mfrc522.PICC_HaltA();
    mfrc522.PCD_StopCrypto1();
